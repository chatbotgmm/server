{
  "name": "galmaegiman-confirmed",
  "version": "0.9.47",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-play.mjs",
    "start": "node --env-file=.env dist/src/server.js",
    "tablet:start": "npm start",
    "setup": "bash scripts/setup.sh",
    "test": "vitest run --maxWorkers=1",
    "test:db": "node scripts/test-db.mjs",
    "db:generate": "prisma generate",
    "data:check": "node --import tsx scripts/check-content.ts",
    "backup": "bash scripts/backup.sh",
    "backup:auto": "bash scripts/backup-auto.sh",
    "url": "node scripts/set-url.mjs",
    "tunnel": "bash scripts/tunnel.sh",
    "reset-data": "bash scripts/reset-data.sh",
    "admin-code": "node scripts/admin-code.mjs",
    "duel-link": "node scripts/duel-link.mjs"
  },
  "dependencies": {
    "@fastify/rate-limit": "^10.1.1",
    "@prisma/client": "^6.16.2",
    "fastify": "^5.6.0",
    "luxon": "^3.7.2",
    "marked": "^15.0.12",
    "phaser": "^4.2.1",
    "prisma": "^6.16.2",
    "three": "^0.186.1",
    "yaml": "^2.8.1",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@types/luxon": "^3.6.2",
    "@types/node": "^24.5.2",
    "esbuild": "^0.28.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2"
  }
}
