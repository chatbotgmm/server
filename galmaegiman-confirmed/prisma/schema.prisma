generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model AppMeta {
  key   String @id
  value String
}

model Player {
  commanderAccount CommanderAccount?
  commanderXpLedger CommanderXpLedger[]
  roster60NormalXp Roster60NormalXpLedger[]
  roster60Story Roster60StoryAccount?
  roster60StoryReceipts Roster60StoryReceipt[]
  roster60StoryAwards Roster60StoryBattleAward[]
  roster60ObservedDefenses Roster60ObservedDefense[]
  roster60Adventures Roster60Adventure[]
  roster60AdventureReceipts Roster60AdventureReceipt[]
  roster60RecruitReceipts Roster60RecruitReceipt[]
  roster60RecruitSessions Roster60RecruitSession[]
  roster60Home Roster60Home?
  roster60Battles Roster60Battle[]
  roster60BattleReceipts Roster60BattleReceipt[]
  roster60State Roster60State?
  roster60Units Roster60Owned[]
  roster60CraftReceipts Roster60CraftReceipt[]
  roster60RebirthAccount Roster60RebirthAccount?
  roster60RebirthReceipts Roster60RebirthReceipt[]
  nativeInbox NativeInboxMessage[]
  nativeNewsReads NativeNewsRead[]
  nativeNewsRequests NativeNewsRequest[]
  id            String            @id @default(uuid())
  identity      String            @unique
  credits       Int               @default(30)
  snack         Int               @default(0)
  lastClaimAt   DateTime?
  isAdmin       Boolean           @default(false)
  adminMode     Boolean           @default(false)
  highPity      Int               @default(0) // 고급 뽑기 천장 카운트(전설 없이 뽑은 횟수)
  nickname      String?           @unique // 랭킹 표시 이름
  peanut        Int               @default(0) // 땅콩: 땅콩떼기로 얻음(쓰임새는 추후)
  tutorial      Int               @default(0) // 튜토리얼 진행 단계(0~4, 4단계: 닉네임)
  inviteCode    String?           @unique // 내 초대 코드
  invitedBy     String? // 나를 초대한 플레이어 id
  partyDraft    String            @default("") // 탐험대 편성 중인 유닛 id(쉼표 구분)
  gameTutorial  Int               @default(0) // 게임 첫 실행 튜토리얼(v0.15.0): 0 미판정 · 1~5 진행 단계 · 9 끝(건너뜀·기존 유저 포함)
  starterLoanEnrolled Boolean @default(false)
  starterLoanEligibleAt DateTime?
  starterLoanGrant StarterLoanGrant?
  gameSeen      String            @default("") // 처음 보는 화면 안내를 본 화면(쉼표 구분)
  battleTeam    String            @default("") // 수비대 대결 팀(최상위 유닛 종류 id 3개, 쉼표 구분, 웹에서 편성)
  badge         String? // 닉네임 옆 장식(땅콩 상점 배지 id)
  rankPoint     Int               @default(1000) // PvP 랭크 점수(v0.11.0)
  rankWins      Int               @default(0)
  rankLosses    Int               @default(0)
  revision      Int               @default(0)
  createdAt     DateTime          @default(now())
  characters    OwnedCharacter[]
  collection    CollectionEntry[]
  actions       PendingAction[]
  ledger        AuditEvent[]
  expeditions   Expedition[]
  achievements  Achievement[]
  daily         DailyProgress[]
  adminSnapshot AdminSnapshot?
  comments      Comment[]
  webLogins     WebLogin[]
  items         PlayerItem[]
  kakao         KakaoLink?
  story         StorySave?
  chatApp       ChatAppUser?
}

// Account story and materials survive owned-unit reincarnation. No unit-level reset hook.
model Roster60StoryAccount {
 playerId String @id
 revision Int @default(0)
 contentVersion String
 state String
 darkGangBalance Int @default(0)
 darkGangLifetime Int @default(0)
 updatedAt DateTime @updatedAt
 player Player @relation(fields:[playerId],references:[id],onDelete:Cascade)
}
model Roster60StoryReceipt {
 playerId String
 requestId String
 fingerprint String
 result String
 createdAt DateTime @default(now())
 player Player @relation(fields:[playerId],references:[id],onDelete:Cascade)
 @@id([playerId,requestId])
}
model Roster60StoryBattleAward {
 playerId String
 battleId String
 questId String?
 amount Int
 outcome String
 createdAt DateTime @default(now())
 player Player @relation(fields:[playerId],references:[id],onDelete:Cascade)
 @@id([playerId,battleId])
}

// New-system identities are separate from legacy C/D/etc definitions. No destructive migration.
model Roster60State {
  playerId String @id
  starterId String @unique
  tutorialProof String?
  completedAt DateTime?
  mailId String? @unique
  selectedId String?
  rewardOwnedId String? @unique
  catalogVersion String?
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
}
model Roster60Owned {
  id String @id @default(uuid())
  playerId String
  speciesId String
  // Cumulative XP within the current growth cycle, not lifetime XP.
  totalXp BigInt @default(0)
  reincarnation Int @default(0)
  status String @default("AVAILABLE")
  locked Boolean @default(false)
  source String
  // Server-validated one-slot override; null preserves existing species skills.
  skillInheritanceJson String?
  createdAt DateTime @default(now())
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  @@unique([playerId, source])
  @@index([playerId, speciesId])
}

model Roster60CraftReceipt {
  playerId String
  requestId String
  fingerprint String
  result String
  createdAt DateTime @default(now())
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  @@id([playerId, requestId])
}

model CharacterDefinition {
  id         String            @id
  name       String
  rarity     String
  position   Int               @unique
  quote      String
  imageUrl   String
  synergy    String?
  owned      OwnedCharacter[]
  collection CollectionEntry[]
}

model OwnedCharacter {
  id           Int                 @id @default(autoincrement())
  playerId     String
  characterId  String
  status       String              @default("AVAILABLE") // AVAILABLE | CONSUMED | EXPEDITION
  locked       Boolean             @default(false)
  expeditionId String?
  reincarnation Int @default(0)
  inheritedFrom String?
  statBonusPct Int @default(0)
  loanExpiresAt DateTime? // null = permanent; server clock, never renewed
  obtainedVia  String
  obtainedAt   DateTime            @default(now())
  consumedAt   DateTime?
  player       Player              @relation(fields: [playerId], references: [id])
  character    CharacterDefinition @relation(fields: [characterId], references: [id])

  @@index([playerId, status, characterId])
}

model CollectionEntry {
  playerId    String
  characterId String
  count       Int                 @default(1)
  player      Player              @relation(fields: [playerId], references: [id])
  character   CharacterDefinition @relation(fields: [characterId], references: [id])

  @@id([playerId, characterId])
}

model Expedition {
  id        String    @id @default(uuid())
  playerId  String
  unitIds   Json
  plan      Json
  startedAt DateTime
  endsAt    DateTime
  claimedAt DateTime?
  result    Json?
  player    Player    @relation(fields: [playerId], references: [id])

  @@index([playerId, claimedAt])
}

model PendingAction {
  token     String   @id
  playerId  String
  revision  Int
  kind      String
  payload   Json
  result    Json?
  expiresAt DateTime
  createdAt DateTime @default(now())
  player    Player   @relation(fields: [playerId], references: [id])

  @@index([playerId, createdAt])
}

model AuditEvent {
  id        String   @id @default(uuid())
  playerId  String
  kind      String
  detail    Json
  createdAt DateTime @default(now())
  player    Player   @relation(fields: [playerId], references: [id])

  @@index([playerId, createdAt])
}

model Achievement {
  playerId  String
  key       String
  createdAt DateTime @default(now())
  player    Player   @relation(fields: [playerId], references: [id])

  @@id([playerId, key])
}

model DailyProgress {
  playerId    String
  day         String
  draws       Int    @default(0)
  crafts      Int    @default(0)
  expeditions Int    @default(0)
  craftRare   Int    @default(0) // 희귀 조합
  craftLegend Int    @default(0) // 전설·히든 조합
  craftTop    Int    @default(0) // 최상위(제한·초월·영원·불멸) 조합
  rewarded    String @default("")
  player      Player @relation(fields: [playerId], references: [id])

  @@id([playerId, day])
}

// 관리자 모드를 켠 순간의 계정 상태. 모드를 끄거나 해제하면 이 상태로 되돌립니다.
model AdminSnapshot {
  playerId  String   @id
  data      Json
  createdAt DateTime @default(now())
  player    Player   @relation(fields: [playerId], references: [id])
}

// 유닛 댓글(카톡에서 쓰고 웹·카톡에서 봄). hidden: 관리자가 숨김
model Comment {
  id          Int      @id @default(autoincrement())
  playerId    String
  characterId String
  text        String
  hidden      Boolean  @default(false)
  likes       Int      @default(0)
  createdAt   DateTime @default(now())
  player      Player   @relation(fields: [playerId], references: [id])

  @@index([characterId, hidden, createdAt])
  @@index([playerId, createdAt])
}

// 좋아요(한 사람·한 브라우저당 댓글마다 1번). voter = "p:플레이어id"(카톡) 또는 "w:방문자 해시"(웹)
model CommentLike {
  commentId Int
  voter     String
  createdAt DateTime @default(now())

  @@id([commentId, voter])
}

// 웹 로그인 코드: 카톡에서 「웹 로그인」을 보내면 6자리 코드(10분, 한 번만). 웹에 입력하면 로그인
model WebLogin {
  code      String    @id
  playerId  String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  player    Player    @relation(fields: [playerId], references: [id])

  @@index([playerId])
}

// 대결 아이템(치료약 등) 보유 수. 종류·가격·효과는 data/battle.yaml items
// 카카오 로그인 연결(웹 「카카오로 로그인」. 처음 한 번은 카톡 코드로 로그인해 연결). 카카오 회원번호 하나 ↔ 플레이어 하나
model KakaoLink {
  kakaoId   String   @id
  playerId  String   @unique
  createdAt DateTime @default(now())
  player    Player   @relation(fields: [playerId], references: [id])
}

// 수비대 대결 스토리 진행(레벨·경험치·배운 기술·승진·깬 스테이지·팀). JSON 한 덩어리, 웹에서 저장
model StorySave {
  playerId  String   @id
  data      String
  updatedAt DateTime @updatedAt
  player    Player   @relation(fields: [playerId], references: [id])
}

// 챗봇 요청에 카카오 로그인 회원번호(appUserId)가 같이 오면 기록 → 웹 카카오 로그인 때 코드 없이 자동 연결
model ChatAppUser {
  appUserId String   @id
  playerId  String   @unique
  updatedAt DateTime @updatedAt
  player    Player   @relation(fields: [playerId], references: [id])
}

model PlayerItem {
  playerId String
  itemId   String
  count    Int    @default(0)
  player   Player @relation(fields: [playerId], references: [id])

  @@id([playerId, itemId])
}

// schema.prisma 끝에 추가. 기존 Player와 기존 랭크 점수는 변경하지 않습니다.
// SQLite + Prisma 6.16.2. 이 모델들은 Player FK 없이 앱 계층에서 존재를 검증합니다.
model RankedProfile {
  playerId          String   @id
  tierIndex         Int      @default(0)
  lp                Int      @default(0)
  promotionActive   Boolean  @default(false)
  promotionWins     Int      @default(0)
  promotionLosses   Int      @default(0)
  rankedMmr         Float    @default(1000)
  casualPriorOffset Float    @default(0)
  games             Int      @default(0)
  wins              Int      @default(0)
  losses            Int      @default(0)
  draws             Int      @default(0)
  version           Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([tierIndex, lp])
}

model CasualHumanRating {
  playerId String   @id
  mmr      Float    @default(1000)
  games    Int      @default(0)
  wins     Int      @default(0)
  losses   Int      @default(0)
  draws    Int      @default(0)
  version  Int      @default(0)
  updatedAt DateTime @updatedAt
}

model RankedMatch {
  roomId           String    @id
  player0Id        String
  player1Id        String
  participant0Kind String
  participant1Kind String
  state            String    @default("ACTIVE")
  winner           Int?
  reason           String?
  configJson       String
  createdAt        DateTime  @default(now())
  finishedAt       DateTime?
  version          Int       @default(0)

  @@index([state, createdAt])
  @@index([player0Id, createdAt])
  @@index([player1Id, createdAt])
}

model RankedSettlement {
  roomId      String   @id
  receiptJson String
  createdAt   DateTime @default(now())
}

model CasualHumanSettlement {
  roomId      String   @id
  player0Id   String
  player1Id   String
  winner      Int?
  receiptJson String
  createdAt   DateTime @default(now())

  @@index([player0Id, createdAt])
  @@index([player1Id, createdAt])
}


// Durable realtime transport state. Historical Player rank fields are untouched.
model RealtimeAttempt {
  id String @id
  playerId String
  mode String
  state String @default("ISSUED")
  issuedAt DateTime
  joinNotAfter DateTime
  queuedAt DateTime?
  leaseUntil DateTime?
  rosterJson String?
  playerName String?
  rating Int @default(1000)
  tierIndex Int @default(0)
  roomId String?
  @@index([mode, state, queuedAt])
  @@index([playerId, state])
}

model RealtimeActivity {
  playerId String @id
  kind String
  targetId String
  expiresAt DateTime
}

model RealtimeRoom {
  id String @id
  mode String
  player0Id String
  player1Id String
  namesJson String
  state String @default("ACTIVE")
  stateJson String
  resultJson String?
  revision Int @default(0)
  deadline DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([state, deadline])
  @@index([player0Id, state])
  @@index([player1Id, state])
}

model RealtimeRequest {
  id String @id
  roomId String
  playerId String
  requestId String
  fingerprint String
  createdAt DateTime @default(now())
  @@unique([roomId, playerId, requestId])
}

// Last lineup actually finalized for realtime PvP; edits alone never overwrite this.
model RealtimeLineup {
  playerId String @id
  teamJson String
  updatedAt DateTime @updatedAt
}


// Early inventory debit with durable exactly-once consume/refund tracking.
model RealtimeItemEscrow {
  roomId String
  phaseId String
  side Int
  playerId String
  itemId String
  state String @default("HELD")
  createdAt DateTime @default(now())
  @@id([roomId, phaseId, side])
  @@index([playerId, itemId, state])
  @@index([roomId, state])
}


// 서버 전용 진행도. Player 삭제 시 게임 서비스가 함께 정리합니다.
model ProgressionState {
  playerId String @id
  points Int @default(0)
  pointDay String @default("")
  dailyPoints Int @default(0)
  rerollAvailable Boolean @default(false)
  rerollExpiresAt DateTime?
  rerollNextClaimAt DateTime?
  reassessNextAt DateTime?
}
model ProgressionReceipt {
  playerId String
  requestId String
  fingerprint String
  result String
  createdAt DateTime @default(now())
  @@id([playerId, requestId])
}
model ProgressionMilestone {
  playerId String
  milestoneId String
  claimedAt DateTime @default(now())
  @@id([playerId, milestoneId])
}


// 생성 이후 수정하지 않는 1회 선택 영수증. ownedIds는 실제 지급 개체 번호이며 종별 삭제 금지.
model StarterLoanGrant {
  id String @id @default(uuid())
  playerId String @unique
  selectedIds Json
  ownedIds Json
  grantedAt DateTime
  expiresAt DateTime
  player Player @relation(fields: [playerId], references: [id])
}

model NativeInboxMessage {
  id String @id @default(uuid())
  playerId String
  title String
  bodyText String
  publishedAt DateTime @default(now())
  expiresAt DateTime?
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  @@index([playerId, publishedAt, id])
}
model NativeNewsRead {
  playerId String
  kind String
  itemId String
  readAt DateTime @default(now())
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  @@id([playerId, kind, itemId])
}
model NativeNewsRequest {
  playerId String
  requestId String
  kind String
  itemId String
  readAt DateTime
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  @@id([playerId, requestId])
}

// Durable server-only level archive; StorySave/reset/loan expiry do not delete this provenance.
model StarterLoanLevel {
  loanOwnedId Int @id
  playerId String
  characterId String
  grantId String
  highestLevel Int @default(1)
  recipientOwnedId Int? @unique
  lastSession String?
  createdAt DateTime
  updatedAt DateTime
  boundAt DateTime?
  @@index([playerId, characterId])
}

model Roster60RebirthAccount {
 playerId String @id
 successes Int @default(0)
 player Player @relation(fields:[playerId],references:[id],onDelete:Cascade)
}
model Roster60RebirthReceipt {
 playerId String
 requestId String
 fingerprint String
 result String
 player Player @relation(fields:[playerId],references:[id],onDelete:Cascade)
 @@id([playerId,requestId])
}

// New authenticated 1v1 sessions; seed and immutable rules snapshot never leave server.
model Roster60Battle {
  id String @id
  playerId String
  ownedId String
  revision Int @default(0)
  status String @default("ACTIVE")
  seed String
  snapshot String
  state String
  settlement String?
  createdAt DateTime @default(now())
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  @@index([playerId, status])
}
model Roster60BattleReceipt {
  playerId String
  requestId String
  fingerprint String
  result String
  createdAt DateTime @default(now())
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  @@id([playerId, requestId])
}

// Account knowledge contains only reactions actually observed against a verified base profile.
model Roster60ObservedDefense {
 playerId String
 speciesId String
 profileKey String
 element String
 reaction String
 firstObservedAt DateTime @default(now())
 lastObservedAt DateTime @updatedAt
 player Player @relation(fields:[playerId],references:[id],onDelete:Cascade)
 @@id([playerId,speciesId,profileKey,element])
 @@index([playerId,speciesId])
}

model Roster60Home {
 playerId String @id
 rebirthUnlocked Boolean @default(false)
 rebirthIntroComplete Boolean @default(false)
 player Player @relation(fields:[playerId],references:[id],onDelete:Cascade)
}

model Roster60RecruitReceipt {
 playerId String
 requestId String
 fingerprint String
 result String
 createdAt DateTime @default(now())
 player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
 @@id([playerId, requestId])
}

model Roster60Adventure {
 id String @id @default(uuid())
 playerId String
 status String @default("ACTIVE")
 revision Int @default(0)
 activeBattleId String?
 catalogVersion String
 state String
 pendingRewards String
 settlement String?
 createdAt DateTime @default(now())
 player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
 @@index([playerId,status])
}
model Roster60AdventureReceipt {
 playerId String
 requestId String
 fingerprint String
 result String
 createdAt DateTime @default(now())
 player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
 @@id([playerId,requestId])
}

// Candidate only: owned units are created exclusively at final claim.
model Roster60RecruitSession {
 id String @id @default(uuid())
 playerId String
 revision Int @default(0)
 status String @default("PENDING")
 snapshot String
 createdAt DateTime @default(now())
 player Player @relation(fields:[playerId], references:[id], onDelete:Cascade)
 @@index([playerId,status])
}

// New roster human PvP; legacy rooms remain independently replayable.
model Roster60PvpParty {
 playerId String @id
 ownedIds String
}
model Roster60PvpQueue {
 playerId String @id
 mode String
 rating Int
 tierIndex Int
 ownedIds String
 queuedAt DateTime
 leaseUntil DateTime
 normalXpSnapshot String?
 commanderXpSnapshot String?
 normalXpCatalogVersion String?
 // Nullable legacy queues have no verified ranked admission or history pool.
 rankPolicyVersion String?
 reincarnationPool String?
 matchPoolPolicyVersion String?
 // Null count is an honest unknown, never a zero-count match class.
 reincarnationCount Int?
 reincarnationCountSource String?
 reincarnationHistoryStamp String?
 rankAdmissionSnapshot String?
 @@index([mode,normalXpCatalogVersion,leaseUntil,queuedAt])
 @@index([mode,rankPolicyVersion,reincarnationPool,leaseUntil,queuedAt])
 @@index([mode,matchPoolPolicyVersion,reincarnationPool,normalXpCatalogVersion,leaseUntil,queuedAt])
}

// Exactly one auditable normal-game XP decision per account, room and real owned unit.
model Roster60NormalXpLedger {
 playerId String
 roomId String
 ownedId String
 policyVersion String?
 outcome String
 reason String
 status String
 requestedXp Int
 appliedXp Int
 deferredXp Int
 startingXp String
 endingXp String
 sourceEncounterId String?
 createdAt DateTime @default(now())
 player Player @relation(fields:[playerId],references:[id],onDelete:Cascade)
 @@id([playerId,roomId,ownedId])
 @@index([playerId,createdAt])
}
model Roster60PvpMatch {
 presence String?
 id String @id
 player0Id String
 player1Id String
 mode String
 status String @default("ACCEPTING")
 revision Int @default(0)
 seed String
 snapshot String
 state String
 deadline DateTime
 settlement String?
 createdAt DateTime @default(now())
 @@index([player0Id,status])
 @@index([player1Id,status])
}

// Independent account progression; owned-unit XP and rebirth never reset this row.
model CommanderAccount {
 playerId String @id
 totalXp BigInt @default(0)
 policyVersion String
 policyFingerprint String
 revision Int @default(0)
 createdAt DateTime @default(now())
 player Player @relation(fields:[playerId],references:[id],onDelete:Cascade)
}

// One immutable account decision per authoritative domain event, irrespective of party size.
model CommanderXpLedger {
 playerId String
 eventKind String
 eventId String
 fingerprint String
 policyVersion String
 policyFingerprint String
 outcome String
 reason String
 status String
 requestedXp Int
 appliedXp Int
 startingXp BigInt
 endingXp BigInt
 result String
 createdAt DateTime @default(now())
 player Player @relation(fields:[playerId],references:[id],onDelete:Cascade)
 @@id([playerId,eventKind,eventId])
 @@index([playerId,createdAt])
}

// ---- 공지·이미지 관리(content-admin). 기존 표와 관계 없음. 플레이어 표를 참조하지 않는다(인증 모듈 독립). ----
model ContentNotice {
 id String @id
 status String
 pinned Boolean @default(false)
 title String
 bodySource String
 bodyHtml String
