generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "sqlite"
  url = env("DATABASE_URL")
}
model AppMeta {
  key String @id
  value String
}
model Player {
  id String @id @default(uuid())
  identity String @unique
  credits Int @default(30)
  snack Int @default(0)
  lastClaimAt DateTime?
  isAdmin Boolean @default(false)
  adminMode Boolean @default(false)
  revision Int @default(0)
  createdAt DateTime @default(now())
  characters OwnedCharacter[]
  collection CollectionEntry[]
  actions PendingAction[]
  ledger AuditEvent[]
  expeditions Expedition[]
  achievements Achievement[]
  daily DailyProgress[]
}
model CharacterDefinition {
  id String @id
  name String
  rarity String
  position Int @unique
  quote String
  imageUrl String
  synergy String?
  owned OwnedCharacter[]
  collection CollectionEntry[]
}
model OwnedCharacter {
  id Int @id @default(autoincrement())
  playerId String
  characterId String
  status String @default("AVAILABLE") // AVAILABLE | CONSUMED | EXPEDITION
  locked Boolean @default(false)
  expeditionId String?
  obtainedVia String
  obtainedAt DateTime @default(now())
  consumedAt DateTime?
  player Player @relation(fields: [playerId], references: [id])
  character CharacterDefinition @relation(fields: [characterId], references: [id])
  @@index([playerId, status, characterId])
}
model CollectionEntry {
  playerId String
  characterId String
  count Int @default(1)
  player Player @relation(fields: [playerId], references: [id])
  character CharacterDefinition @relation(fields: [characterId], references: [id])
  @@id([playerId, characterId])
}
model Expedition {
  id String @id @default(uuid())
  playerId String
  unitIds Json
  plan Json
  startedAt DateTime
  endsAt DateTime
  claimedAt DateTime?
  result Json?
  player Player @relation(fields: [playerId], references: [id])
  @@index([playerId, claimedAt])
}
model PendingAction {
  token String @id
  playerId String
  revision Int
  kind String
  payload Json
  result Json?
  expiresAt DateTime
  createdAt DateTime @default(now())
  player Player @relation(fields: [playerId], references: [id])
  @@index([playerId, createdAt])
}
model AuditEvent {
  id String @id @default(uuid())
  playerId String
  kind String
  detail Json
  createdAt DateTime @default(now())
  player Player @relation(fields: [playerId], references: [id])
  @@index([playerId, createdAt])
}
model Achievement {
  playerId String
  key String
  createdAt DateTime @default(now())
  player Player @relation(fields: [playerId], references: [id])
  @@id([playerId, key])
}
model DailyProgress {
  playerId String
  day String
  draws Int @default(0)
  crafts Int @default(0)
  expeditions Int @default(0)
  rewarded String @default("")
  player Player @relation(fields: [playerId], references: [id])
  @@id([playerId, day])
}
