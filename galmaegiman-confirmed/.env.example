# setup.sh가 비밀키를 생성합니다. 이전 앱의 .env를 복사하지 마세요.
DATABASE_URL="file:../storage/confirmed.db"
HOST=127.0.0.1
PORT=3000
KAKAO_BOT_ID=
SKILL_SECRET=
PUBLIC_BASE_URL=
LOG_ENABLED=true
# 관리자(무제한 뽑기) 코드. npm run admin-code 로 생성
ADMIN_CODE=
# 카카오 로그인(선택). 넣으려면: bash scripts/kakao-keys.sh
KAKAO_REST_KEY=
KAKAO_CLIENT_SECRET=
# 스토어 심사용 로그인 코드(숫자 6자리). 정하면 「내 갈매미」 로그인에서 이 코드로 심사 전용 계정에 들어가요
REVIEW_CODE=
