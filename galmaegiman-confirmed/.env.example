# setup.sh가 비밀키를 생성합니다. 이전 앱의 .env를 복사하지 마세요.
DATABASE_URL="file:../storage/confirmed.db"
HOST=127.0.0.1
PORT=3000
KAKAO_BOT_ID=
SKILL_SECRET=
PUBLIC_BASE_URL=
LOG_ENABLED=true
# 관리자(무제한 뽑기) 코드. npm run admin-code 로 생성
ADMIN_CODE=
# 카카오 로그인(선택). 넣으려면: bash scripts/kakao-keys.sh
KAKAO_REST_KEY=
KAKAO_CLIENT_SECRET=
# 승인 후 별도 준비하는 심사 계정. 미설정/잘못된 설정이면 로그인 불가. 평문/실제 값 커밋 금지.
REVIEW_LOGIN_ENABLED=false
REVIEW_LOGIN_USERNAME=
REVIEW_LOGIN_PLAYER_ID=
REVIEW_LOGIN_PASSWORD_HASH=
REVIEW_LOGIN_VERSION=
# 단체방(그룹) 챗봇(선택). 비밀값을 넣으면 /kakao/group/* 주소가 켜져요. 1:1 챗봇 SKILL_SECRET과 다른 값(32자 이상)
# BOT_ENV: 개발채널 봇이면 dev, 운영채널 봇이면 prod(서로 다른 서버·DB로 운영). GROUP_BOT_ID를 넣으면 다른 봇 요청을 거절
GROUP_SKILL_SECRET=
BOT_ENV=
GROUP_BOT_ID=
# 선톡(카카오 심사 후에만). 기본 꺼짐
PROACTIVE_MSG_ENABLED=false
